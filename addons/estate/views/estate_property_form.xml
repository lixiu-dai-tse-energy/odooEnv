<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_property" model="ir.ui.view">
        <field name="name">property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Test">
                <header >
                    <!--<button name="action_treate_offers" type="object" string="Treat offer"/>-->
                    <button name="action_canncel" type ="object" string="Canncel"  invisible="state in ['Cannceled', 'Sold']" />
                    <button name="action_sold" type ="object" string="Sold"  invisible="state in ['Cannceled', 'Sold']" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" style="font-size:50px "  />
                            <group >
<!--                                <field name="property_type_id" widget="many2one_tags"/>-->
                                <field name="property_tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                            </group>
                        </group>
                        <group>
                            <field name="last_seen" />
                        </group>
                             <group>
                            <field name="postcode"  />
                                 <field name="date_avaibility"  />
                                 <field name="expected_price"  />
                                 <field name="selling_price"  />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                            <field name="bedrooms"  />
                            <field name="living_area" />
                            <field name="facades"  />
                            <field name="garden"  />
                            <field name="garage"  />
                            <field name="garden_area"  invisible="not garden"/>
                            <field name="garden_orientation" invisible="not garden"/>
                            <field name="last_seen" />
                            <field name="last_seen" />
                            <field name="state" widget="statusbar" statusbar_visible="New,Offer Received,Offer Accepted,Sold"/>
                            <field name="total_area"/>
                            <field name="best_price"/>
                        </group>
                        </page>
                           <page string="Other info">
                            <group>
                             <field name="property_seller_id"/>
                             <field name="property_buyer_id"/>
                        </group>
                        </page>
                         <page string="Offers">
                            <group>
                                <field name="property_offer_ids" readonly="state in ['Offer Accepted', 'Sold', 'Cancelled']"
                            context="{'form_view_ref': 'estate_property_offer_view_form'}" />
                        </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>