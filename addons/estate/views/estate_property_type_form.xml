<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_type_view_form" model="ir.ui.view">
    <field name="name">property.type.form</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
        <form string="Property Type">
            <sheet>
                <group>

                    <field name="name"/>
                </group>

                <!-- Section pour afficher les propriétés associées -->
                <notebook>
                    <page string="Related Properties">
                        <field name="property_ids" readonly="1" options="{'no_create':True, 'no_open': True}">
                            <list>

                                <field name="name"/>
                                <field name="expected_price"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
</odoo>
